# ==========================================
# Device Identification
# ==========================================
ro.product.model=SM-A047F
ro.product.device=a04s
ro.product.name=a04snnxx
ro.hardware=exynos850

# ==========================================
# Audio (A13 optimisations)
# ==========================================
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
ro.config.systemaudiodebug=abox
ro.config.vc_call_vol_steps=8
audio.offload.min.duration.secs=30
af.fast_track_multiplier=1

# ==========================================
# Bluetooth (A13 + A04s)
# ==========================================
bluetooth.device.class_of_device=90,2,12
bluetooth.device.default_name=Galaxy A04s
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true
persist.bluetooth.bqr.event_mask=0
persist.bluetooth.bqr.min_interval_ms=0

# ==========================================
# Display & Graphics (A13 + A04s)
# ==========================================
debug.sf.disable_backpressure=1
debug.sf.latch_unsignaled=1
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.set_display_power_timer_ms=200
ro.surface_flinger.set_idle_timer_ms=1500
ro.surface_flinger.set_touch_timer_ms=100
ro.surface_flinger.use_content_detection_for_refresh_rate=true
persist.sys.sf.color_saturation=1.0
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.vsync_event_phase_offset_ns=0
ro.surface_flinger.vsync_sf_event_phase_offset_ns=0
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.supports_background_blur=1

# ==========================================
# DRM
# ==========================================
drm.service.enabled=true

# ==========================================
# Radio & Connectivity (A13 RIL additions)
# ==========================================
ro.radio.noril=no
ro.multisim.simslotcount=2
persist.radio.multisim.config=dsds
ro.telephony.default_cdma_sub=0
ro.telephony.default_network=9,9
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so
ro.product_ship=true
wifi.interface=wlan0
wifi.direct.interface=p2p0
ro.boot.wificountrycode=00
ro.vendor.epdg.support=true
ro.vendor.sec.radio.def_network=9

# ==========================================
# Hardware Identity
# ==========================================
ro.hardware.chipname=exynos850
ro.soc.manufacturer=Samsung
ro.soc.model=Exynos 850
debug.slsi_platform=1
ro.hw.use_contig_memory_for_scratch_buf=1
ro.hw.use_hwc_services=1
ro.hw.use_virtual_display=1

# ==========================================
# NFC (STMicro ST21 – A04s specific)
# ==========================================
ro.vendor.nfc.feature.chipname=STM_ST21
ro.vendor.nfc.support.uicc=true
ro.vendor.nfc.support.autoselect=true
ro.camera.notify_nfc=1
ro.vendor.nfc.info.deviceHeight=164.7
ro.vendor.nfc.info.deviceWidth=76.7
