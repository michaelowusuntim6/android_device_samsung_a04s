# Declare KernelSU configuration permissions
type ksu_device_type, domain;

# Grant system, shell, app, and init access to interact with the KernelSU dev node
allow { init shell system_server platform_app untrusted_app_all priv_app } ksu_device:chr_file rw_file_perms;

# Prevent audit spams for domains checking it during baseline loops
dontaudit { isolated_app_all su } ksu_device:chr_file rw_file_perms;
